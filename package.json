{
  "name": "@titah/extension-git",
  "version": "0.4.0",
  "description": "lazygit-style git sidebar for Titah — files, worktrees, branches, commits, stash. Read-only.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6",
    "titah": "^0.5.0"
  },
  "titah": {
    "panel": "./dist/panel.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "titah-code": "^0.7.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "titah",
    "titah-extension",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/titah-dev/titah-extension-git.git"
  }
}
